# Node API
PORT=4000
NODE_ENV=development

# Database PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret
POSTGRES_DB=iphone_flipping
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_secret@postgres:5432/iphone_flipping

# Redis Cache & Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Python ML Microservice
ML_SERVICE_URL=http://ml-service:8000

# Next.js Dashboard
NEXT_PUBLIC_API_URL=http://localhost:4000

# Scanner Automatico
SCAN_INTERVAL_MINUTES=10
SCAN_QUERIES=iphone 13,iphone 14,iphone 15,iphone 16
SCAN_DELAY_BETWEEN_MODELS_MS=20000
SCAN_MAX_PAGES=2
SCAN_MIN_PRICE=80
SCAN_MAX_PRICE=1200
MIN_ROI_THRESHOLD=15
MIN_PROFIT_THRESHOLD=50
MIN_PRICE_DROP_PCT_THRESHOLD=5

# Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true
